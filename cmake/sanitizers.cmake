if(POPNET_ASAN)
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    add_compile_options(-fsanitize=address -fno-omit-frame-pointer)
    add_link_options(-fsanitize=address)
    message(STATUS "ASAN enabled")
  elseif(MSVC)
    if(CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 19.27 AND CMAKE_SIZEOF_VOID_P EQUAL 8)
      # MSVC ASAN only supports x64 from VS 2019 v16.7 (MSVC version 19.27)
      add_compile_options(/fsanitize=address)
      add_link_options(/fsanitize=address)
      message(STATUS "ASAN enabled")
    else()
      message(WARNING "ASAN not supported. ASAN on MSVC requires x64 and Visual Studio 2019 v16.7 or newer.")
    endif()
  else()
    message(WARNING "ASAN not supported")
  endif()
endif()

if(POPNET_UBSAN)
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    add_compile_options(-fsanitize=undefined)
    add_link_options(-fsanitize=undefined)
    message(STATUS "UBSAN enabled")
  else()
    message(WARNING "UBSAN not supported")
  endif()
endif()

if(POPNET_TSAN)
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    add_compile_options(-fsanitize=thread)
    add_link_options(-fsanitize=thread)
    message(STATUS "TSAN enabled")
  else()
    message(WARNING "TSAN not supported")
  endif()
endif()